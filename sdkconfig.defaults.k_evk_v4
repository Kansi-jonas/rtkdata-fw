# K_EVK_V4.0 Ethernet board (2.x). Layered ON TOP of sdkconfig.defaults by
# CMakeLists.txt when building with -DRTK_BOARD=k_evk_v4. Never used for the
# OnoLink Wi-Fi fleet build.

CONFIG_RTK_BOARD_K_EVK_V4=y

# ESP32 EMAC + LAN8720 over RMII. The 50 MHz reference comes FROM the PHY
# (LAN8720A REFCLKO, R102 0R) INTO GPIO0. Espressif's recommended topology when
# Wi-Fi runs too; the vendor's handoff sheet saying "GPIO0 OUT" is wrong.
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_INPUT=y
CONFIG_ETH_RMII_CLK_IN_GPIO=0

# ESP32-WROOM-32UE-N16R2: 2 MB PSRAM in the D0WDR2-V3 package (CS on GPIO16,
# GPIO17 stays free for the GNSS UART). Boot on without it rather than
# bricking if a board variant lacks it; the banner logs the detected size.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y
