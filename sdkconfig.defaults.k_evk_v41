# K_EVK_V4.1 Ethernet board (schematic K_EVK_V4.0_SCH_1013, 2.1.x). Layered ON
# TOP of sdkconfig.defaults by CMakeLists.txt when building with
# -DRTK_BOARD=k_evk_v41. Never used for the OnoLink Wi-Fi fleet build or V4.0.

CONFIG_RTK_BOARD_K_EVK_V41=y

# ESP32 EMAC + LAN8720 over RMII. The 50 MHz reference comes from oscillator Y7
# (REF_CLK In mode) INTO GPIO0, the same ESP32 side as V4.0: clock input on
# GPIO0. eth_init() enables Y7 through GPIO2 before the driver starts.
CONFIG_ETH_USE_ESP32_EMAC=y
CONFIG_ETH_PHY_INTERFACE_RMII=y
CONFIG_ETH_RMII_CLK_INPUT=y
CONFIG_ETH_RMII_CLK_IN_GPIO=0

# ESP32-WROOM-32UE-N16R2: 2 MB PSRAM in the D0WDR2-V3 package (CS on GPIO16,
# GPIO17 stays free for the GNSS UART). Boot on without it rather than
# bricking if a board variant lacks it; the banner logs the detected size.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# Internal RAM budget (first hardware run 15.10.: Ethernet + AP + STA + web
# server exhausted the internal heap within a minute of boot, task creation
# failed and the supervisor rebooted in a loop). Wi-Fi and lwIP buffers may
# live in PSRAM, and only allocations up to 4 KB prefer internal RAM (default
# 16 KB). DMA and ISR memory is requested with explicit caps and stays internal.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# mbedTLS through the normal heap (2026-11-13). The IDF default pins every
# mbedTLS allocation to internal RAM; the 16 KB record buffer plus the
# handshake then needed more than the ~40 KB internal RAM left after start-up,
# and the first enroll on the bench failed with mbedtls_ssl_setup -0x7F00
# (ALLOC_FAILED). With the default allocator the big buffers go to PSRAM
# (above SPIRAM_MALLOC_ALWAYSINTERNAL) and fall back to internal RAM on a
# board without PSRAM; EXTERNAL_MEM_ALLOC would break TLS there.
# CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC is not set
CONFIG_MBEDTLS_DEFAULT_MEM_ALLOC=y

# IRAM budget (2026-11-06). The UART ISR moved into IRAM (sdkconfig.defaults,
# GNSS bytes survive flash writes) and overflowed iram0 by 2432 bytes on this
# board: the PSRAM cache workaround already places much of newlib in IRAM.
# The Wi-Fi RX fast path is the cheapest place to take it from (Espressif:
# about 17 KB): on this board Wi-Fi is fallback and setup only, and the
# station moves a few KB/s. The OnoLink build keeps it (Wi-Fi is its uplink).
# Alternative with more headroom: CONFIG_ESP32_REV_MIN_3 drops the PSRAM
# workaround (the samples are v3.1), but then no older chip can boot it.
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
